{
  "expo": {
    "name": "UniSync",
    "slug": "unisync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-single-no-bg.png",
    "scheme": "unisync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-single-no-bg.png",
      "bundleIdentifier": "com.oplanojames.unisync"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oplanojames.unisync"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/ios-icon-default.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        [
          "expo-splash-screen",
          {
            "backgroundColor": "#0051D5",
            "image": "./assets/images/iOS.png",
            "imageWidth": 200,
            "dark": {
              "image": "./assets/images/iOS.png",
              "backgroundColor": "#0051D5"
            }
          }
        ]
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
